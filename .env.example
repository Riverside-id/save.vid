# ─────────────────────────────────────────────────────────────
# Social Saver — environment variables
# Copy to .env.local for local development (`npm run setup` does it for you).
# NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# REQUIRED. Shared HMAC secret used by the Python resolver (signs media tokens)
# and the Next.js media proxy (verifies them). Use 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MEDIA_TOKEN_SECRET=

# Optional. Media token lifetime in seconds (default 3600).
MEDIA_TOKEN_TTL_SECONDS=3600

# Optional. Upper bound for a single proxied file, in megabytes (default 250).
MAX_MEDIA_MB=250

# Optional. Upper bound for a ZIP download, in megabytes (default 300) and items (default 20).
MAX_ZIP_MB=300
MAX_ZIP_ITEMS=20

# Optional. Rate limits per client IP (requests per minute).
RATE_LIMIT_RESOLVE_PER_MIN=10
RATE_LIMIT_MEDIA_PER_MIN=120
RATE_LIMIT_ZIP_PER_MIN=6
RATE_LIMIT_AUDIO_PER_MIN=10

# Optional. Shared rate limiting across instances with Upstash Redis (REST API).
# When empty, an in-memory limiter per function instance is used (best effort).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development only — where Next.js proxies /api/resolve.
# Leave empty on Vercel (Vercel routes /api/resolve to api/resolve.py itself).
PYTHON_API_URL=
